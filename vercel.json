{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/play",
      "destination": "/play/index.html"
    },
    {
      "source": "/play/",
      "destination": "/play/index.html"
    },
    {
      "source": "/trivia",
      "destination": "/trivia/index.html"
    },
    {
      "source": "/trivia/",
      "destination": "/trivia/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/play/(assets|canvaskit|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=daily",
      "permanent": false
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=social&utm_campaign=daily",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=social&utm_campaign=daily",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "/?utm_source=x&utm_medium=social&utm_campaign=daily",
      "permanent": false
    },
    {
      "source": "/r",
      "destination": "/?utm_source=reddit&utm_medium=social&utm_campaign=daily",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/?utm_source=youtube&utm_medium=social&utm_campaign=daily",
      "permanent": false
    },
    {
      "source": "/li",
      "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=daily",
      "permanent": false
    }
  ]
}
